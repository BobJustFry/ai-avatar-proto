# Higgsfield: генерация персонажа и замена внешности в видео.
# Ключ выпускается в консоли и состоит из двух частей.
# Внимание: на пробном тарифе API заблокирован, нужен платный план.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# Провайдер фотореалистичного аватара (LiveAvatar / HeyGen).
# Без него работает всё, кроме режима «Фотореалистичный аватар провайдера».
LIVEAVATAR_API_KEY=

# Синтез голоса. Без него из голосовых режимов остаётся только «Мой голос».
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Порт статики и API.
PORT=5173
